#!/bin/bash

set -e
script_base=$(dirname "$0")
cd $script_base/..

source $script_base/utils

POSITIONAL=()
while [[ $# -gt 0 ]]; do
    key="$1"
    case $key in
        -h|--help|?)
            echo "Stop all or specfic running Docker services."
            echo
            cecho "Usage: $(basename $0) [SERVICE...]" default bold
            echo
            echo "Environment Variables:"
            echo "  PROD=0              Force dev compose files (default: COMPOSE_FILE, else dev)"
            echo "  PROD=1              Force prod: docker-compose.yml + docker-compose.prod.yml"
            exit 0
            ;;
        *)
            POSITIONAL+=("$1")
            ;;
    esac
    shift
done
set -- "${POSITIONAL[@]}"

# Default to development environment

docker_compose stop $@
