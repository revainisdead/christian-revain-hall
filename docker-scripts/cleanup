#!/bin/bash

# Only touches this compose project's resources (by compose project label).

# Stop containers
# Delete python cache files
# Deleting stopped Docker containers
# Deleting dangling images (images with no container)
# Deleting volumes (all data)
# The database volume is kept.


set -e
SCRIPT_BASE=$(dirname "$0")
cd $SCRIPT_BASE/..

source $SCRIPT_BASE/utils

# Never deleted by this script.
PROTECTED_VOLUMES=(
    christian-hall_db-volume
)

# Resources from other projects on this machine that older versions of this script filtered out
# by name. Not used anymore: the commands below are scoped by compose project label, so other
# projects' resources are never listed in the first place. Kept for reference.
OTHER_PROJECT_RESOURCES=(
    # summit-knowledge-integration
    summit-knowledge-integration_db
    summit-knowledge-integration_web
    summit-knowledge-integration_celery
    summit-knowledge-integration_static_build
    summit-knowledge-integration_redis
    summit-knowledge-integration_vue
    summit-knowledge-integration_jasmine
    summit-knowledge_db-volume
    summit-knowledge_python-packages
    summit-knowledge_redis-volume
    summit-knowledge_static-files
    # erp-service
    erp-service_erp
    erp-service_celery
    erp-service_db
    erp-service_redis
    erp-service_db-volume
    erp-service_python-packages
    erp-service_redis-volume
    erp-service_upload-volume
    # login-service
    login-service_login
    login-service_nginx
    login-service_db
    login-service_redis
    login-service_db-volume
    login-service_python-packages
    login-service_redis-volume
)

docker=
no_input=

POSITIONAL=()
while [[ $# -gt 0 ]]; do
    key="$1"
    case $key in
        -d|--docker)
            docker=1
            ;;
        -y|--no-input)
            no_input=1
            ;;
        -h|--help|?)
            echo "Clean up build files, caches and excess Docker artifacts."
            echo
            cecho "Usage: $(basename $0) <options>" default bold
            echo
            echo "Services:"
            echo "$(docker_compose config --services)"
            echo
            echo "Options:"
            echo "  -y  --no-input      Assume yes for all user input"
            echo "  -h  --help          This help message"
            echo
            echo "Environment Variables:"
            echo "  PROD=0              Force dev compose files (default: COMPOSE_FILE, else dev)"
            echo "  PROD=1              Force prod: docker-compose.yml + docker-compose.prod.yml"
            exit 0
            ;;
        *)
            POSITIONAL+=("$1")
            ;;
    esac
    shift
done
set -- "${POSITIONAL[@]}"

if [ ! "$no_input" ]; then
    cecho "This will stop you running services and delete cache, build files and docker volumes." yellow bold
    read -n1 -r -p "Press 'Y' to continue or any other key to cancel..." key
    echo
    if [ ! "$key" ] || [[ "yY" != *"$key"* ]]; then
        echo
        cecho "Aborting." red
        exit 0
    fi
fi

echo
cecho "Stopping running services..." default bold
$SCRIPT_BASE/stop

#echo
#cecho "Deleting python cache files..." default bold
#find . \( -type f -name "*.pyc" -o -type d -name __pycache__ \) -delete

if [ "$(which docker)" ]; then
    # Everything below is scoped to this compose project via the labels compose puts on
    # containers, volumes and images, so other projects' resources are never touched.
    project=$(docker_compose config 2>/dev/null | awk '/^name:/ {print $2; exit}')
    project=${project:-$(basename "$PWD")}
    project_filter="label=com.docker.compose.project=$project"

    echo
    cecho "Removing $project containers and network..." default bold
    docker_compose down --remove-orphans

    # Keep the database volume; everything else unused by this project goes.
    volume_list=$(docker volume ls -q --filter dangling=true --filter "$project_filter" |
        grep -v -x -F -f <(printf '%s\n' "${PROTECTED_VOLUMES[@]}") || true)
    if [ "$volume_list" ]; then
        cecho "Removing docker volumes: ${volume_list}" green
        docker volume rm -f $volume_list
    fi

    image_list=$(docker images -q --filter dangling=true --filter "$project_filter")
    if [ "$image_list" ]; then
        cecho "Removing dangling docker images: ${image_list}" green
        docker rmi -f $image_list
    fi
fi
