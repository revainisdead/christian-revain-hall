#!/bin/bash

set -e

SCRIPT_BASE=$(dirname "$0")

source $SCRIPT_BASE/utils

# Install Docker
# https://docs.docker.com/engine/install/ubuntu/

sudo apt-get update --yes
sudo apt-get install --yes apt-transport-https curl ca-certificates curl gnupg lsb-release

sudo install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo gpg --dearmor -o /etc/apt/keyrings/docker.gpg
sudo chmod a+r /etc/apt/keyrings/docker.gpg

#echo \
#  "deb [arch=amd64 signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu \
#  $(lsb_release -cs) stable" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null

echo \
    "deb [arch="$(dpkg --print-architecture)" signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu \
    "$(. /etc/os-release && echo "$VERSION_CODENAME")" stable" | \
    sudo tee /etc/apt/sources.list.d/docker.list > /dev/null

sudo apt-get update
sudo apt-get install --yes docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

# Compose v2 comes from docker-compose-plugin above (`docker compose ...`); v1 (docker-compose 1.x) is not used.

sudo usermod -aG docker $USER
echo "Added $USER to the docker group: log out and back in (or run 'newgrp docker') to use docker without sudo."
