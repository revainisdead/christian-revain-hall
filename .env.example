# Copy to .env and fill in. .env is gitignored and loaded by docker compose (env_file).

# Django secret key. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Prod server only: make plain `docker compose` / docker-scripts use the prod overrides.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Google sign-in. Google Cloud console > APIs & Services > Credentials > Create OAuth client ID (Web application).
# Authorized JavaScript origins: http://localhost:8007 (dev) and your prod https:// domain. No redirect URI needed.
# Empty = the login page shows Google sign-in as "not set up". After editing .env: make up
GOOGLE_CLIENT_ID=

# Username/password login (dev login box, /api/auth/login|register|token). Defaults to DEBUG; keep off in prod.
# PASSWORD_LOGIN_ENABLED=false
