# Production nginx: serves client/dist/spa, proxies Django, terminates TLS (Let's Encrypt).
FROM nginx:1.28

#RUN apk update && apk add bash

RUN apt-get update && apt-get --yes install \
    # ps
    procps \
    # netstat
    net-tools \
    vim \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN rm /etc/nginx/conf.d/default.conf
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf
# Self-signed placeholder or Let's Encrypt cert link, on every container start.
COPY --chmod=755 nginx/40-ssl-cert.sh /docker-entrypoint.d/40-ssl-cert.sh


