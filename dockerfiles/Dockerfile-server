# Django server image (dev and prod). Python version must match .github/workflows/server.yml.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Dev conveniences for `docker-scripts/console`. psycopg[binary] bundles libpq, so no build deps are needed.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        vim \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --uid 1000 --create-home crh

WORKDIR /srv/app
COPY server server
WORKDIR /srv/app/server

RUN pip install pip-tools

ENV CUSTOM_COMPILE_COMMAND="DO NOT EDIT THIS FILE! Instead, edit the \*requirements.in file(s) and rebuild the image"

RUN pip-compile requirements.in --output-file requirements.txt \
    && pip-compile dev-requirements.in --output-file dev-requirements.txt \
    && pip-sync requirements.txt dev-requirements.txt

USER crh

LABEL app="blunderproof"

